{
  "name": "m32-thermal-patch",
  "version": "0.1.2",
  "description": "Locate and raise the Samsung sec_battery emergency overheat shutdown threshold inside dtbo.img, with byte-level verification. No dependencies.",
  "type": "module",
  "bin": { "patch-dtbo": "src/patch-dtbo.mjs" },
  "scripts": {
    "list": "node src/patch-dtbo.mjs --list",
    "dry": "node src/patch-dtbo.mjs",
    "build": "node tools/bundle.mjs",
    "build:exe": "node tools/build-sea.mjs",
    "test": "node test/build-fixture.mjs && node test/selftest.mjs && node test/cli-refusals.mjs",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=18" },
  "files": ["src/", "dist/patch-dtbo.mjs", "dist/patch-dtbo.cjs", "README.md", "TUTORIAL.md", "LICENSE"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheRealAshik/m32-thermal-patch.git"
  },
  "homepage": "https://github.com/TheRealAshik/m32-thermal-patch#readme",
  "keywords": [
    "samsung",
    "sm-m325f",
    "galaxy-m32",
    "dtbo",
    "device-tree",
    "thermal",
    "overheat",
    "odin"
  ]
}
